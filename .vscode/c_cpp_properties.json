{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/Source/**",
                "${workspaceFolder}/JuceLibraryCode",
                "C:/Program Files/JUCE/modules",
                "${workspaceFolder}/ThirdParty/signalsmith-stretch/include",
                "${workspaceFolder}/ThirdParty/signalsmith-linear/include"
            ],
            "defines": [
                "_DEBUG",
                "DEBUG=1",
                "JUCE_GLOBAL_MODULE_SETTINGS_INCLUDED=1",
                "JUCE_STANDALONE_APPLICATION=1",
                "JUCE_USE_CURL=0",
                "JUCE_WEB_BROWSER=0",
                "_CRT_SECURE_NO_WARNINGS"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ],
    "version": 4
}
